{
  "name": "monitorflow-website",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "guides": "node scripts/fetch-guides.mjs",
    "predev": "node scripts/fetch-guides.mjs --if-missing",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-guides.mjs --if-missing",
    "build": "next build && node scripts/check-text.mjs out",
    "check": "node scripts/check-text.mjs src scripts content README.md docs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "serve": "node scripts/serve.mjs out"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "marked": "18.1.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
