{
  "name": "monitorflow-website",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "guides": "node scripts/fetch-guides.mjs",
    "demo": "node scripts/build-demo.mjs",
    "predev": "node scripts/fetch-guides.mjs --if-missing && node scripts/build-demo.mjs --if-missing",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-guides.mjs --if-missing && node scripts/build-demo.mjs --if-missing",
    "build": "next build && node scripts/check-text.mjs --skip out/demo out",
    "check": "node scripts/check-text.mjs src scripts content README.md docs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "serve": "node scripts/serve.mjs out"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "marked": "18.2.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
